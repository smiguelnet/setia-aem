<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Home"
        pageTitle="Setia — Your global software outsourcing partner"
        cq:template="/conf/setia/settings/wcm/templates/landing-page"
        sling:resourceType="setia/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="setia/components/container"
            layout="responsiveGrid">
            <home-hero
                jcr:primaryType="nt:unstructured"
                sling:resourceType="setia/components/home-hero"
                mainTitle="Your global software outsourcing partner"
                subtitle=""
                backgroundImage="/content/dam/setia/images/hero-backgrounds/bg-home.jpg">
                <serviceCards jcr:primaryType="nt:unstructured">
                    <item0
                        jcr:primaryType="nt:unstructured"
                        title="Blockchain, Smart Contracts and NFTs"
                        description="We create, design, and deploy enterprise-grade solutions, based on Ethereum, Binance and Stellar blockchain technology."
                        linkUrl="/content/setia/us/en/solutions"
                        linkText="Learn More"/>
                    <item1
                        jcr:primaryType="nt:unstructured"
                        title="Cloud-Native Software Development"
                        description="Innovative Web and Mobile applications creating digital experiences tailored to your business."
                        linkUrl="/content/setia/us/en/services"
                        linkText="Learn More"/>
                    <item2
                        jcr:primaryType="nt:unstructured"
                        title="Digital Transformation and Industry 4.0"
                        description="Robotic Process Automation (RPA) is one of the catalysts of Industry 4.0. Automate across multiple applications."
                        linkUrl="/content/setia/us/en/services"
                        linkText="Learn More"/>
                </serviceCards>
            </home-hero>
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="setia/components/container"
                layout="responsiveGrid">
                <tagline
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="setia/components/section-heading"
                    title="Delivering Innovative and Quality Solutions"
                    subtitle="Leading you through the journey to transform your ideas into accessible digital products."
                    headingLevel="h2"
                    alignment="left"/>
                <what-we-do
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="setia/components/section-heading"
                    title="What we do"
                    subtitle="Digital Products for Future-Ready Businesses"
                    headingLevel="h2"
                    alignment="left"/>
                <services-grid
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="setia/components/card-grid"
                    columns="3"
                    gap="medium">
                    <cardItems jcr:primaryType="nt:unstructured">
                        <item0 jcr:primaryType="nt:unstructured" title="Blockchain Application Development"/>
                        <item1 jcr:primaryType="nt:unstructured" title="Mobile Application Development"/>
                        <item2 jcr:primaryType="nt:unstructured" title="Cloud-native Applications Development"/>
                        <item3 jcr:primaryType="nt:unstructured" title="Enterprise Application Development"/>
                        <item4 jcr:primaryType="nt:unstructured" title="Enterprise Application Integration"/>
                        <item5 jcr:primaryType="nt:unstructured" title="Robotic Process Automation Implementation"/>
                    </cardItems>
                </services-grid>
            </container>
            <engagement
                jcr:primaryType="nt:unstructured"
                sling:resourceType="setia/components/rich-text-section"
                cssClass="bg-green"
                title="Engagement. Gamification as a key element"
                subtitle="Connects smaller tasks to larger goals with Gamification."
                text="&lt;p>Gamification informs, motivates and incites action with the player. It also has the power to change people&apos;s behavior. Similar to a game, in a corporate market we have different players, they are users, customers and sponsors and we want them to get involved with the best possible performance, moving towards the desired goal.&lt;/p>"/>
            <ready-section
                jcr:primaryType="nt:unstructured"
                sling:resourceType="setia/components/section-heading"
                title="Ready to tackle your next challenge?"
                subtitle="Setia can help you build value through innovation."
                headingLevel="h2"
                alignment="left"/>
            <cta-section
                jcr:primaryType="nt:unstructured"
                sling:resourceType="setia/components/cta-section"
                title="Get in touch"
                subtitle="connect@setia.com.br"
                buttonText="Contact us"
                buttonLink="mailto:connect@setia.com.br"
                includeMascot="true"
                mascotImage="/content/dam/setia/logos/brand/contact_area.png"
                mascotAlt="Setia mascot"/>
        </root>
    </jcr:content>
</jcr:root>
