<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        jcr:primaryType="cq:PageContent"
        jcr:title="Company"
        pageTitle="We are Setia"
        cq:template="/conf/setia/settings/wcm/templates/page-content"
        sling:resourceType="setia/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="setia/components/container"
            layout="responsiveGrid">
            <page-banner
                jcr:primaryType="nt:unstructured"
                sling:resourceType="setia/components/page-banner"
                title="We are Setia"
                subtitle="Delivering Innovative and Quality Solutions"
                backgroundImage="/content/dam/setia/images/banners/bg-content.jpg"/>
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="setia/components/container"
                layout="responsiveGrid">
                <our-story
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="setia/components/rich-text-section"
                    title="Our Story"
                    subtitle="Offering solutions to a wide range of clients in a variety of fields for more than 21 years"
                    text="&lt;p>Founded in 2000, Setia has been a profitable and successful company working with some of the state&apos;s largest and most recognized businesses, associations and institutions.&lt;/p>"/>
                <what-makes-setia
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="setia/components/rich-text-section"
                    cssClass="bg-green"
                    title="What makes Setia different?"
                    subtitle="We pave the way for your innovation, creativity and profitability"
                    text="&lt;p>We&apos;ve created custom applications and solutions for some of the most iconic brands and We are people serving market with people-centered design and software engineering.&lt;/p>&lt;h6>So, why Setia?&lt;/h6>&lt;ul>&lt;li>&lt;strong>Turn Opportunities Into Results&lt;/strong> — From small businesses to large companies, we empower brands to succeed online.&lt;/li>&lt;li>&lt;strong>Processes, Products and People&lt;/strong> — Setia has standardized, defined and documented processes in their software development practice in order to deliver quality software and solutions.&lt;/li>&lt;li>&lt;strong>Engagement-first. Gamification as a key element&lt;/strong> — Increase the engagement of your applications by applying game elements to promote desired behaviors among customers and employees.&lt;/li>&lt;/ul>"/>
                <downloads
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="setia/components/download-list"
                    title="Brochures / Download">
                    <downloadItems jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            fileTitle="Institutional Presentation"
                            fileDescription="Overview of Setia&apos;s capabilities and services"
                            fileAsset="/content/dam/setia/documents/presentations/setia-institucional.pdf"
                            fileSize="1.9 MB"/>
                        <item1
                            jcr:primaryType="nt:unstructured"
                            fileTitle="Software Development Method"
                            fileDescription="Setia&apos;s proven software development methodology"
                            fileAsset="/content/dam/setia/documents/presentations/metodo-trabalho-setia.pdf"
                            fileSize="2.0 MB"/>
                        <item2
                            jcr:primaryType="nt:unstructured"
                            fileTitle="MPS.BR"
                            fileDescription="Brazilian Software Process Improvement certification"
                            fileAsset="/content/dam/setia/documents/presentations/metodo-trabalho-setia.pdf"
                            fileSize="2.0 MB"/>
                    </downloadItems>
                </downloads>
                <our-services-heading
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="setia/components/section-heading"
                    title="Our services"
                    subtitle="Digital Products for Future-Ready Businesses"
                    headingLevel="h2"
                    alignment="left"/>
                <services-grid
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="setia/components/card-grid"
                    columns="3"
                    gap="medium">
                    <cardItems jcr:primaryType="nt:unstructured">
                        <item0 jcr:primaryType="nt:unstructured" title="Blockchain Application Development"/>
                        <item1 jcr:primaryType="nt:unstructured" title="Mobile Application Development"/>
                        <item2 jcr:primaryType="nt:unstructured" title="Cloud-native Applications Development"/>
                        <item3 jcr:primaryType="nt:unstructured" title="Enterprise Application Development"/>
                        <item4 jcr:primaryType="nt:unstructured" title="Enterprise Application Integration"/>
                        <item5 jcr:primaryType="nt:unstructured" title="Robotic Process Automation Implementation"/>
                    </cardItems>
                </services-grid>
                <partners-heading
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="setia/components/section-heading"
                    title="Partners"
                    headingLevel="h2"
                    alignment="left"/>
                <partners
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="setia/components/logo-gallery">
                    <logos jcr:primaryType="nt:unstructured">
                        <item0 jcr:primaryType="nt:unstructured" imagePath="/content/dam/setia/logos/partners/parceria_aws.png" altText="Amazon Web Services" width="120px"/>
                        <item1 jcr:primaryType="nt:unstructured" imagePath="/content/dam/setia/logos/partners/parceria_neo.png" altText="Neo4j" width="100px"/>
                        <item2 jcr:primaryType="nt:unstructured" imagePath="/content/dam/setia/logos/partners/parceria_ibm.png" altText="IBM" width="100px"/>
                        <item3 jcr:primaryType="nt:unstructured" imagePath="/content/dam/setia/logos/partners/parceria_its.png" altText="ITS" width="120px"/>
                    </logos>
                </partners>
                <ready-section
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="setia/components/section-heading"
                    title="Ready to tackle your next challenge?"
                    subtitle="Setia can help you build value through innovation."
                    headingLevel="h2"
                    alignment="left"/>
            </container>
            <cta-section
                jcr:primaryType="nt:unstructured"
                sling:resourceType="setia/components/cta-section"
                title="Get in touch"
                subtitle="connect@setia.com.br"
                buttonText="Contact us"
                buttonLink="mailto:connect@setia.com.br"
                includeMascot="true"
                mascotImage="/content/dam/setia/logos/brand/contact_area.png"
                mascotAlt="Setia mascot"/>
        </root>
    </jcr:content>
</jcr:root>
