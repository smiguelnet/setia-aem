<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/setia/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Footer"
        sling:resourceType="setia/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="setia/components/container"
            layout="responsiveGrid">
            <cta
                jcr:primaryType="nt:unstructured"
                sling:resourceType="setia/components/cta-section"
                title="Get in touch"
                subtitle="connect@setia.com.br"
                buttonText=""
                buttonLink="mailto:connect@setia.com.br"
                includeMascot="true"
                mascotImage="/content/dam/setia/logos/brand/contact_area.png"
                mascotAlt="Setia mascot — customer service representative"/>
            <copyright
                jcr:primaryType="nt:unstructured"
                sling:resourceType="setia/components/text"
                text="&lt;p>Copyright&amp;copy; Setia Technology 2005-2026. All rights reserved.&lt;/p>"
                textIsRich="true"/>
        </root>
    </jcr:content>
</jcr:root>
