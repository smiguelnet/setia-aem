<?xml version="1.0" encoding="UTF-8"?>
<workspaceFilter version="1.0">
    <!-- Templates and policies are code — replace mode so structural refactors apply cleanly -->
    <filter root="/conf/setia"/>
    <!-- Pages bootstrapped from source — replace mode wipes archetype placeholders -->
    <filter root="/content/setia"/>

    <!--
        DAM strategy (see docs/plans/08-dam-asset-strategy.md):
        - Folder .content.xml stubs deploy in merge mode to create the folder hierarchy
        - Asset binaries are NOT version-controlled; they are uploaded separately
        - merge mode ensures existing author-uploaded assets are never overwritten by a build
    -->
    <filter root="/content/dam/setia" mode="merge">
        <!-- Exclude binary renditions and original files -->
        <exclude pattern="/content/dam/setia(/.*)?.original"/>
        <exclude pattern="/content/dam/setia(/.*)?/renditions(/.*)?"/>
        <include pattern="/content/dam/setia(/.*)?"/>
    </filter>

    <!-- XFs are code-controlled — replace mode -->
    <filter root="/content/experience-fragments/setia"/>
</workspaceFilter>
